{
  "name": "estates",
  "version": "0.1.0",
  "description": "A deterministic property-trading board game: rules engine, bots, headless simulator and a browser client.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run build && node dist/src/sim/check.js",
    "sim": "npm run build && node dist/src/sim/cli.js",
    "mutants": "node tools/mutants.mjs",
    "serve": "npm run build && node tools/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
